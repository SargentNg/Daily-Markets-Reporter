# Copy this file to .env and fill in real values. .env is gitignored.
#
# SMTP_USER  -- the Gmail address that owns the app password
# SMTP_PASS  -- the 16-character Gmail app password (no spaces).
#               Requires 2-Step Verification enabled on that account:
#               https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=abcdefghijklmnop